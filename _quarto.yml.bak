project:
  type: website
  resources:
    - qna/questions.json
    - assets/firebase-config.json
    - assets/post-likes.js
    - assets/likes-store.mjs

website:
  description: "A blog built with Quarto"
  site-url: https://youngandyou.github.io/mathastro/
  title: "MathAstro"
  navbar:
    right:
      - href: about.qmd
        text: "블로그 소개"
      - href: team.qmd
        text: "운영진 소개"
      - href: qna/
        text: "Q&A"
format:
  html:
    theme:
      - cosmo
      - brand
    css: styles.css
    html-math-method: mathjax
    filters:
      - pseudocode
    include-after-body:
      - assets/category-tree.html
      - assets/pseudocode.html
      - assets/post-likes.html
